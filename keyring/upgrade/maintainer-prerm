#!/bin/sh
set -e

# Removing or deconfiguring the package switches the timer off, and the package
# remembers that it was the one that did. The operator's own `systemctl disable`
# leaves no such memory, which is how the two are told apart afterwards: what the
# package suspended it restores, what the operator disabled stays disabled.
state=/var/lib/glyndor-archive-keyring
case "$1" in
	remove | deconfigure)
		if [ -d /run/systemd/system ]; then
			# Two questions, answered separately. Whether to remember a
			# restore depends on the timer having been enabled. Whether to stop
			# it does not: an operator's `systemctl disable` without --now
			# leaves it running, and it must not keep firing upgrades while
			# the package is being removed.
			if systemctl is-enabled --quiet glyndor-upgrade.timer 2>/dev/null; then
				# Remembering the restore is best effort. A state directory that
				# cannot be written (a read-only /var/lib, a file where the
				# directory should be) must not abort the removal with set -e or
				# leave the timer firing: the postinst treats the same condition
				# as a warning.
				if ! { mkdir -p "$state" && : > "$state/suspended-by-package"; } 2>/dev/null; then
					echo "glyndor-archive-keyring: $state is not writable; the timer is stopped but its restore is not remembered" >&2
				fi
				systemctl disable --now glyndor-upgrade.timer || true
			elif systemctl is-active --quiet glyndor-upgrade.timer 2>/dev/null; then
				systemctl stop glyndor-upgrade.timer || true
			fi
		fi
		;;
esac
exit 0
