#!/bin/sh
# Upgrade the packages that come from apt.glyndor.net, and only those.
#
# Run daily by glyndor-upgrade.timer. unattended-upgrade does the work; this
# script narrows it to this archive. apt reads the file named by APT_CONFIG
# before the system configuration, so a "clear" in it cannot remove Debian's
# origins. A strict Package-Whitelist can: a package that is not on the list is
# never touched, whatever origin it comes from.
#
# The list is not "every Glyndor package". It is exactly what apt would change
# to upgrade the Glyndor packages installed here, asked of `apt-get -s`: those
# packages plus any dependency a new release adds or needs upgraded. Both
# simpler lists were measured on Debian 13 and fail in opposite directions:
#   strict, Glyndor names only   a release that adds a Depends is "kept back
#                                because a related package is kept back",
#                                forever and silently;
#   non-strict                   upgrading podup also upgraded curl, the kernel
#                                and other packages it has nothing to do with.
# Read at run time, so a product published tomorrow is covered without a new
# keyring.
#
# Whatever the operator has configured still applies afterwards, including
# Unattended-Upgrade::Package-Blacklist: that is their per-package opt-out.
set -eu

RUN="${GLYNDOR_RUN_DIR:-/run/glyndor-upgrade}"

apt-get update -qq

# A package name is lowercase alphanumerics, dot, plus and hyphen (Debian policy),
# with an optional ":arch" on a foreign architecture. Anything else must never
# reach the config below, where a quote or a newline would end the string and let
# a line of its own through. A name that fails is not filtered away quietly: that
# would let a plan look empty, and "everything is current" would be reported over
# an upgrade that was never attempted. It fails the unit and is named in the
# journal. The index is signed, so this is the second lock, not the only one.
# Called in the main shell on purpose: an `exit` inside a command substitution
# would end only the subshell and the script would carry on with an empty list.
reject_invalid() { # $1 = what the names are, $2 = the names, one per line
	_bad="$(printf '%s\n' "$2" | grep -vE '^[a-z0-9][a-z0-9.+-]+(:[a-z0-9-]+)?$' | grep -v '^$' || true)"
	if [ -n "$_bad" ]; then
		echo "glyndor-upgrade: refusing to run, invalid package name in $1: $(printf '%s\n' "$_bad" | head -1)" >&2
		exit 1
	fi
}

# The index files are asked of apt, not guessed from a file name: a machine that
# keeps its indexes compressed (Acquire::GzipIndexes) holds them as .lz4 or .gz,
# and apt-helper reads whichever form apt kept. A machine with no Glyndor index
# at all, or none apt can read, fails the unit instead of looking current.
APT_HELPER="${GLYNDOR_APT_HELPER:-/usr/lib/apt/apt-helper}"
# shellcheck disable=SC2016 # $(FILENAME) is apt's format syntax, not a shell expansion
index_files="$(apt-get indextargets --format '$(FILENAME)' \
	'Created-By: Packages' 'Origin: Glyndor' 'Suite: stable' 2>/dev/null || true)"
names_raw=""
for f in $index_files; do
	# An index that cannot be read fails the unit: skipping it would shrink the
	# plan and report the packages only it listed as current.
	if ! content="$("$APT_HELPER" cat-file "$f" 2>/dev/null)"; then
		echo "glyndor-upgrade: cannot read the Glyndor index $f" >&2
		exit 1
	fi
	names_raw="$names_raw
$(printf '%s\n' "$content" | awk '/^Package: /{print $2}')"
done
reject_invalid "the Glyndor index" "$names_raw"
names="$(printf '%s\n' "$names_raw" | grep -v '^$' | sort -u || true)"
if [ -z "$names" ]; then
	echo "glyndor-upgrade: no readable Glyndor package index, nothing to upgrade" >&2
	exit 1
fi

# Only what is installed: --only-upgrade never installs a Glyndor package the
# operator did not choose.
# shellcheck disable=SC2086 # one argument per package name
# ${binary:Package} keeps the ":arch" of a foreign-architecture package. Without
# it apt is asked about the native package of that name, which is not installed,
# and a pending upgrade of the foreign one is reported as current.
installed="$(dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' $names 2>/dev/null \
	| awk '$1 == "ii" {print $2}')"
if [ -z "$installed" ]; then
	echo "glyndor-upgrade: no Glyndor package is installed, nothing to upgrade"
	exit 0
fi

# The simulation's own exit status is what separates "nothing to upgrade" from
# "could not tell": a locked dpkg or a broken dependency makes apt-get fail, and
# reading that as an empty plan would report everything current while nothing
# was upgraded. It fails the unit instead, with apt's message in the journal.
# shellcheck disable=SC2086
if ! sim="$(apt-get -s --only-upgrade install $installed)"; then
	echo "glyndor-upgrade: apt could not plan the upgrade, nothing was upgraded" >&2
	exit 1
fi
plan_raw="$(printf '%s\n' "$sim" | awk '/^Inst / {print $2}')"
reject_invalid "the upgrade plan" "$plan_raw"
plan="$(printf '%s\n' "$plan_raw" | grep -v '^$' | sort -u || true)"
if [ -z "$plan" ]; then
	echo "glyndor-upgrade: everything from the Glyndor archive is current"
	exit 0
fi

# One private file per invocation. A fixed name let a second invocation replace
# the plan between this one writing it and the engine reading it. The engine is
# not exec'd, so the file can be removed whatever the engine returns.
mkdir -p "$RUN"
conf="$(mktemp "$RUN/apt.conf.XXXXXX")"
trap 'rm -f "$conf"' EXIT
{
	echo 'Unattended-Upgrade::Allowed-Origins { "Glyndor:stable"; };'
	echo 'Unattended-Upgrade::Package-Whitelist-Strict "true";'
	echo 'Unattended-Upgrade::Package-Whitelist {'
	# Names are matched as regular expressions, so "." and "+" are written as
	# classes; a backslash would need a second level of escaping in this file.
	for n in $plan; do
		printf '\t"^%s$";\n' "$(printf '%s' "$n" | sed 's/[.+]/[&]/g')"
	done
	echo '};'
} > "$conf"

rc=0
APT_CONFIG="$conf" "${GLYNDOR_UNATTENDED:-unattended-upgrade}" || rc=$?
exit "$rc"
