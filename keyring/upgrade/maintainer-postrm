#!/bin/sh
set -e
case "$1" in
	remove | purge)
		if [ -d /run/systemd/system ]; then
			systemctl daemon-reload || true
		fi
		# Removing the package undoes its choices, so a reinstall offers the
		# timer again instead of inheriting a marker from the old install.
		rm -rf /var/lib/glyndor-archive-keyring
		;;
esac
exit 0
